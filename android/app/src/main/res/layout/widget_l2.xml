<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_dark"
    android:orientation="horizontal"
    android:padding="6dp">
    <LinearLayout android:id="@+id/weather_box" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.95" android:background="@drawable/tile_sky" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.5" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
            <TextView android:id="@+id/city_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="13sp" />
            <TextView android:id="@+id/refresh" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/btn_on_dark" android:contentDescription="@string/refresh" android:gravity="center" android:text="&#x21BB;" android:textColor="#FFFFFF" android:textSize="15sp" />
        </LinearLayout>
        <TextView android:id="@+id/sun" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.5" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="60sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/weather" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="74sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
            <TextView android:id="@+id/temp_high" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/temp_low" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="18sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/aqi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.6" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="14sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" android:visibility="gone" android:paddingStart="6dp" android:paddingEnd="6dp" />
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="6dp" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25" android:orientation="vertical" android:gravity="center_vertical" android:padding="0dp">
        <LinearLayout android:id="@+id/info" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="2.1" android:background="@drawable/tile_date" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
            <TextView android:id="@+id/date" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="#3B2600" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="30sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
            <TextView android:id="@+id/date2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="#3B2600" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="6dp" />
        <LinearLayout android:id="@+id/prayer_row" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.8" android:background="@drawable/tile_azan" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
                <TextView android:id="@+id/prayer_label" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:gravity="center_vertical|start" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" />
                <Chronometer android:id="@+id/prayer_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="6dp" />
        <LinearLayout android:id="@+id/cell_rate" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.8" android:background="@drawable/tile_dollar" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
                <TextView android:id="@+id/lbl_rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="13sp" android:autoSizeStepGranularity="1sp" />
                <TextView android:id="@+id/rate" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.4" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="20sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="6dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:background="@drawable/tile_net" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
                <TextView android:id="@+id/flag" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="24sp" android:autoSizeStepGranularity="1sp" />
                <TextView android:id="@+id/country" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.2" android:ellipsize="end" android:gravity="center_vertical|start" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" android:textStyle="bold" />
                <TextView android:id="@+id/ip" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3" android:ellipsize="end" android:gravity="center_vertical|end" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="6dp" />
        <LinearLayout android:id="@+id/usage_box" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.7" android:background="@drawable/tile_usage" android:orientation="vertical" android:gravity="center_vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:padding="0dp">
                <TextView android:id="@+id/wifi" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
                <TextView android:id="@+id/sim" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="end" android:gravity="center" android:maxLines="1" android:textColor="#FFFFFF" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="6sp" android:autoSizeMaxTextSize="16sp" android:autoSizeStepGranularity="1sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
